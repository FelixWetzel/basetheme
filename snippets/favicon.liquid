{% doc %}
  Favicon and iOS home-screen icon from Theme-Einstellungen → Logo →
  Favicon (falls back to the signet). Without either, Shopify's
  default favicon is used.
{% enddoc %}
{%- assign favicon = settings.favicon | default: settings.logo_signet -%}
{%- if favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ favicon | image_url: width: 96, height: 96 }}">
  {% # iOS home screen / Safari need a PNG; 180px is the size iOS asks for %}
  <link rel="apple-touch-icon" href="{{ favicon | image_url: width: 180, height: 180 }}">
{%- endif -%}
