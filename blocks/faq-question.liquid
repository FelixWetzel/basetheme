<details class="faq-accordion" {{ block.shopify_attributes }}>
  <summary class="faq-accordion__summary">
    <span>{{ block.settings.question }}</span>
    <span class="faq-accordion__icon icon-plus" aria-hidden="true"></span>
  </summary>
  <div class="faq-accordion__content rte">{{ block.settings.answer }}</div>
</details>

{% stylesheet %}
  .faq-accordion {
    border-top: 1px solid var(--color-border);
  }

  .faq-accordion__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-8) 0;
    cursor: pointer;
    list-style: none;
  }

  .faq-accordion__summary::-webkit-details-marker {
    display: none;
  }

  /* Closed: thin "+" from .icon-plus (critical.css). Open: the
     font's own "−", so the drawn icon is switched off. */
  .faq-accordion[open] .faq-accordion__icon::before {
    content: '−';
    width: auto;
    height: auto;
    vertical-align: baseline;
    background: none;
    mask: none;
  }

  /* Same as the product page accordion: one blank line (a line
     height) between the question and the answer — the summary's own
     8px bottom padding already counts towards it. */
  .faq-accordion__content {
    padding-top: calc(var(--line-height-body) - var(--space-8));
    padding-bottom: var(--space-16);
  }

  /* Flush with the rest of the text (no browser-default list indent),
     matching the product-page accordion's plain, non-bulleted style. */
  .faq-accordion__content ul,
  .faq-accordion__content ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Square bullets (matching the dots used elsewhere in the theme)
     instead of the browser's default round ones. */
  .faq-accordion__content ul li {
    position: relative;
    padding-left: calc(4px + var(--space-6));
  }

  .faq-accordion__content ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 4px;
    height: 4px;
    background-color: var(--color-foreground);
  }
{% endstylesheet %}

{% javascript %}
  // Animates the accordion's native open/close instead of the instant
  // default — same technique as the product-page accordion
  // (sections/product.liquid): a `height` Web Animation from/to the
  // collapsed and expanded pixel heights, only setting the real
  // `open` attribute once it finishes. Clicking the content while
  // open (not just the <summary>) also closes it.
  document.querySelectorAll('.faq-accordion').forEach((details) => {
    const summary = details.querySelector('.faq-accordion__summary');
    const content = details.querySelector('.faq-accordion__content');
    if (!summary || !content) return;

    let animation = null;
    let isClosing = false;
    let isExpanding = false;

    const onFinish = (open) => {
      details.open = open;
      animation = null;
      isClosing = false;
      isExpanding = false;
      details.style.height = details.style.overflow = '';
    };

    const expand = () => {
      isExpanding = true;
      const startHeight = `${details.offsetHeight}px`;
      const endHeight = `${summary.offsetHeight + content.offsetHeight}px`;
      animation?.cancel();
      animation = details.animate({ height: [startHeight, endHeight] }, { duration: 250, easing: 'ease' });
      animation.onfinish = () => onFinish(true);
      animation.oncancel = () => (isExpanding = false);
    };

    const close = () => {
      if (!details.open) return;
      isClosing = true;
      const startHeight = `${details.offsetHeight}px`;
      const endHeight = `${summary.offsetHeight}px`;
      details.style.overflow = 'hidden';
      animation?.cancel();
      animation = details.animate({ height: [startHeight, endHeight] }, { duration: 250, easing: 'ease' });
      animation.onfinish = () => onFinish(false);
      animation.oncancel = () => (isClosing = false);
    };

    const open = () => {
      details.style.overflow = 'hidden';
      details.style.height = `${details.offsetHeight}px`;
      details.open = true;
      window.requestAnimationFrame(expand);
    };

    summary.addEventListener('click', (event) => {
      event.preventDefault();
      if (isClosing || !details.open) {
        open();
      } else if (isExpanding || details.open) {
        close();
      }
    });

    content.addEventListener('click', close);
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.faq_question",
  "settings": [
    {
      "type": "text",
      "id": "question",
      "label": "t:labels.question",
      "default": "Text oder Frage"
    },
    {
      "type": "richtext",
      "id": "answer",
      "label": "t:labels.answer"
    }
  ],
  "presets": [
    {
      "name": "t:general.faq_question"
    }
  ]
}
{% endschema %}
