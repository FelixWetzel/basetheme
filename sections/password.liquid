{% comment %}
  Landing page shown while the store is password protected: a short
  message and a newsletter link at the top, the password form below,
  and the big footer wordmark closing off the page — the same
  typographic ending as every other page.
{% endcomment %}

<div class="password-page">
  <div class="password-page__intro">
    <p class="password-page__title">{{ 'password.title' | t }}</p>

    {% if shop.password_message != blank %}
      <p class="password-page__message">{{ shop.password_message }}</p>
    {% endif %}

    <a href="#newsletter-popup" class="password-page__newsletter cta">{{ 'password.newsletter' | t }}</a>
  </div>

  {% form 'storefront_password', class: 'password-page__form' %}
    {% if form.errors %}
      <div class="password-page__error">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="password-page__field">
      <input
        type="password"
        name="password"
        id="password-input"
        class="password-page__input"
        placeholder="{{ 'password.password' | t }}"
        aria-label="{{ 'password.password' | t }}"
        autocomplete="current-password"
        required
      >
      <button type="submit" class="password-page__submit">{{ 'password.enter' | t }}</button>
    </div>
  {% endform %}

  <div class="password-page__logo" aria-label="{{ shop.name }}">
    {% render 'logo', type: 'large' %}
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: flex;
    flex-direction: column;
    gap: var(--space-96);
    min-height: 100svh;
    padding: var(--space-16) var(--page-margin);
  }

  .password-page__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 26rem;
  }

  .password-page__title {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-versal);
  }

  .password-page__message {
    margin: 0;
  }

  .password-page__newsletter {
    align-self: flex-start;
    margin-top: var(--space-8);
    color: var(--color-foreground);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-versal);
    transition: opacity 0.3s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .password-page__newsletter:hover {
      opacity: 0.7;
    }
  }

  /* Pushed down so the wordmark always sits at the bottom of the
     screen, however little content there is above it. */
  .password-page__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    max-width: 26rem;
    margin-top: auto;
  }

  .password-page__error ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .password-page__field {
    display: flex;
  }

  .password-page__input {
    flex: 1;
    min-width: 0;
    padding: var(--space-16);
    border: 1px solid var(--color-foreground);
    border-right: none;
    background: none;
    font: inherit;
    color: var(--color-foreground);
    outline: none;
  }

  .password-page__input::placeholder {
    color: var(--color-foreground);
    opacity: 1;
  }

  .password-page__submit {
    padding: var(--space-16);
    border: none;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font: inherit;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-versal);
    cursor: pointer;
    transition: opacity 0.3s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .password-page__submit:hover {
      opacity: 0.9;
    }
  }

  .password-page__logo .theme-logo:not(.theme-logo--text) {
    width: 100%;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
