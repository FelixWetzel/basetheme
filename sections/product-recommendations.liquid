{% comment %}
  Rendered dynamically via Shopify's native product recommendations
  endpoint (fetched from sections/product.liquid's JS), not part of
  any template's JSON — Shopify renders this file on demand when
  `section_id=product-recommendations` is requested.
{% endcomment %}

{% if recommendations.performed and recommendations.products_count > 0 %}
  <div class="product-recommendations full-width">
    {% render 'product-recommendations-content', products: recommendations.products %}
  </div>
{% endif %}

{% stylesheet %}
  .product-recommendations {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-16) var(--page-margin) 0;
    border-top: 1px solid var(--color-border);
  }

  /* Desktop: close to the product (the gallery ends right above the
     line). Mobile: the line moves 96px below the add-to-cart button
     (minus the 16px the product panel already leaves below it), so it
     separates the purchase from the recommendations instead of
     closing off the button. */
  @media (max-width: 749px) {
    .product-recommendations {
      margin-top: calc(var(--space-96) - var(--space-16));
    }
  }

  .product-recommendations__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .product-recommendations__cta {
    flex-shrink: 0;
    text-decoration: none;
    color: var(--color-foreground);
    transition: opacity 0.3s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-recommendations__cta:hover {
      opacity: 0.7;
    }
  }

  .product-recommendations__heading {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-versal);
  }

  .product-recommendations__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-32) var(--space-4);
  }

  @media (min-width: 750px) {
    .product-recommendations__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product_recommendations",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
