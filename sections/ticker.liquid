{% comment %}
  Horizontally scrolling marquee of a single repeating text message.
  JS repeats it until the row is at least as wide as the viewport (so
  the loop never shows a blank gap), then duplicates that whole row
  once more back-to-back and shifts the track by exactly its width —
  a seamless loop at any text length or screen size. Top and bottom
  spacing are selectable, as on sections/text.liquid — large (96px)
  or small (16px); by default large above, small below, as before.
{% endcomment %}

<div class="ticker ticker--spacing-{{ section.settings.spacing_top }} ticker--spacing-bottom-{{ section.settings.spacing_bottom }} full-width">
  {% if section.settings.text != blank %}
    <div class="ticker__track" data-ticker-track data-ticker-speed="{{ section.settings.speed }}">
      <div class="ticker__group" data-ticker-group>
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}" class="ticker__item">
            {{ section.settings.text }}
          </a>
        {% else %}
          <span class="ticker__item">
            {{ section.settings.text }}
          </span>
        {% endif %}
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .ticker {
    overflow: hidden;
    padding: var(--space-16) 0;
    color: var(--color-foreground);
  }

  .ticker--spacing-large {
    padding-top: var(--space-96);
  }

  .ticker--spacing-bottom-large {
    padding-bottom: var(--space-96);
  }

  .ticker__track {
    display: flex;
    align-items: center;
    gap: var(--space-96);
    width: max-content;
  }

  .ticker__track.is-ready {
    animation: ticker-scroll var(--ticker-duration, 60s) linear infinite;
  }

  @keyframes ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--ticker-shift, -50%));
    }
  }

  .ticker__group {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--space-96);
  }

  .ticker__item {
    margin: 0;
    display: inline-block;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker__track.is-ready {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    document.querySelectorAll('[data-ticker-track]').forEach((track) => {
      const group = track.querySelector('[data-ticker-group]');
      if (!group) return;

      // Constant crawl speed (px/second) regardless of text length —
      // a longer message just takes proportionally longer to loop
      // rather than scrolling faster. Merchant-configurable.
      const pxPerSecond = Number(track.dataset.tickerSpeed) || 20;

      // Repeat the message until the row is at least as wide as the
      // viewport, so the loop never shows a blank gap. The repeats
      // are hidden from assistive tech — only the first copy is read.
      // Measures the width once and computes how many copies are
      // needed up front, instead of re-reading scrollWidth (forcing
      // a layout reflow) after every single clone appended.
      const originalItems = Array.from(group.children);
      const originalWidth = group.scrollWidth;
      if (originalWidth > 0) {
        const copiesNeeded = Math.ceil(window.innerWidth / originalWidth);
        for (let i = 1; i < copiesNeeded; i++) {
          originalItems.forEach((item) => {
            const repeat = item.cloneNode(true);
            repeat.setAttribute('aria-hidden', 'true');
            group.appendChild(repeat);
          });
        }
      }

      // Duplicate the whole (now wide-enough) row once more, back to
      // back, so shifting the track by exactly that width loops it
      // seamlessly.
      const clone = group.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);

      const gapPx = parseFloat(getComputedStyle(track).columnGap) || 0;
      const shift = group.scrollWidth + gapPx;

      track.style.setProperty('--ticker-shift', `-${shift}px`);
      track.style.setProperty('--ticker-duration', `${shift / pxPerSecond}s`);
      track.classList.add('is-ready');
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.ticker",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Lauftext"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:labels.speed",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "select",
      "id": "spacing_top",
      "label": "t:labels.spacing_top",
      "options": [
        { "value": "small", "label": "t:options.spacing_top.small" },
        { "value": "large", "label": "t:options.spacing_top.large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "spacing_bottom",
      "label": "t:labels.spacing_bottom",
      "options": [
        { "value": "small", "label": "t:options.spacing_top.small" },
        { "value": "large", "label": "t:options.spacing_top.large" }
      ],
      "default": "small"
    }
  ],
  "presets": [{ "name": "t:general.ticker" }],
  "enabled_on": {
    "templates": ["index", "page"],
    "groups": ["footer"]
  }
}
{% endschema %}
