{% comment %}
  Dealers ("Händler") page: a full-width submenu (see
  snippets/page-submenu.liquid), then a headline (left) and, on the
  right on desktop, an optional rich text above dealer locations
  grouped by city, added as theme-editor blocks.
{% endcomment %}

<div class="dealers-header full-width">
  {% render 'page-submenu', menu: section.settings.submenu %}

  <div class="dealers-body">
    {% if section.settings.headline != blank or section.settings.text != blank %}
      <div class="dealers-intro">
        {% if section.settings.headline != blank %}
          <p class="dealers-headline">{{ section.settings.headline }}</p>
        {% endif %}

        {% if section.settings.text != blank %}
          {% render 'read-more', text: section.settings.text, rich: true, class: 'dealers-text' %}
        {% endif %}
      </div>
    {% endif %}

    <div class="dealers-list">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .dealers-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding-top: var(--space-16);
    padding-left: var(--page-margin);
    padding-right: var(--page-margin);
  }

  .dealers-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  /* Mobile: headline with the optional text directly below it.
     Desktop: the wrapper dissolves (display: contents) so the text can
     sit in the right column, above the list. */
  .dealers-intro {
    display: flex;
    flex-direction: column;
  }

  .dealers-headline {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-versal);
  }

  .dealers-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  @media (min-width: 750px) {
    .dealers-body {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--space-4);
      row-gap: var(--space-32);
      align-items: start;
    }

    .dealers-intro {
      display: contents;
    }

    .dealers-headline {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .dealers-text {
      grid-column: 3 / 5;
      grid-row: 1;
    }

    /* Below the text if there is one, otherwise next to the headline
       (auto-placement takes the first free row in these columns). */
    .dealers-list {
      grid-column: 3 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.dealers",
  "settings": [
    {
      "type": "link_list",
      "id": "submenu",
      "label": "t:labels.submenu",
      "info": "t:labels.submenu_info"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "t:labels.headline"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text"
    }
  ],
  "blocks": [
    { "type": "dealer-city" }
  ],
  "presets": [
    {
      "name": "t:general.dealers",
      "blocks": [
        { "type": "dealer-city" }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
